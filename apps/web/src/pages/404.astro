---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="mx-auto max-w-content px-6 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary-600">404</p>
    <h1 class="mt-2 text-h1 font-bold text-ink-900">Page not found</h1>
    <p class="mx-auto mt-3 max-w-[50ch] text-lg text-ink-600">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-700"
    >
      Back to Home
    </a>
  </div>
</BaseLayout>
