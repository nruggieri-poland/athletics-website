---
// polandathletics.com/ne8 — conference-specific news only. Pulls
// articles tagged "NE8" in the CMS via getArticlesForTag, same helper
// already used for other tag-scoped pages (e.g. Fans) — completely
// independent of the general News feed/excludeFromNewsFeed: an article
// can appear here, in the general feed, both, or (if flagged
// excludeFromNewsFeed) here only.
//
// Also the doorway to /ne8/awards — the All-Conference awards section
// hangs off this page in the URL and the breadcrumbs, so it leads here too.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/articles/ArticleCard.astro";
import { getArticlesForTag } from "../../lib/payload";
import type { AwardSeason } from "../../lib/awards";
import {
  getAwardSeasons,
  honoreeCount,
  latestSeason,
  photoPosition,
  photoUrl,
  seasonCover,
  seasonHref,
  seasonName,
} from "../../lib/awards";

const articles = await getArticlesForTag("ne8", 50);

let seasons: AwardSeason[] = [];
try {
  seasons = await getAwardSeasons();
} catch {
  // CMS unreachable at build time — the awards banner just doesn't render.
}
const latest = latestSeason(seasons);
const cover = latest ? seasonCover(latest) : undefined;
---

<BaseLayout
  title="NE8 Conference"
  description="News, updates, and All-Conference awards from the NE8 athletic conference."
>
  <div class="border-b border-ink-100 py-12">
    <div class="mx-auto max-w-content px-6">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-primary-600">Conference</p>
      <h1 class="max-w-[20ch] text-h1 font-bold text-ink-900">NE8</h1>
      <p class="mt-3 max-w-[62ch] text-lg text-ink-600">
        News and updates from across the NE8 athletic conference.
      </p>
    </div>
  </div>

  {
    latest && (
      <section class="mx-auto max-w-content px-6 pt-10">
        <a
          href="/ne8/awards"
          class="group relative isolate flex min-h-56 flex-col justify-end overflow-hidden rounded-3xl bg-primary-900 p-8 text-white md:min-h-64 md:p-10"
        >
          {cover && (
            <img
              src={photoUrl(cover, "card")}
              alt=""
              class="absolute inset-y-0 right-0 -z-10 h-full w-full object-cover opacity-40 transition-[scale] duration-500 group-hover:scale-105 motion-reduce:transition-none md:w-3/5"
              style={`object-position: ${photoPosition(cover)}; mask-image: linear-gradient(to right, transparent, #000 50%); -webkit-mask-image: linear-gradient(to right, transparent, #000 50%)`}
            />
          )}
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#f5c542]">
            All-Conference Awards
          </p>
          <p class="mt-2 max-w-[20ch] text-3xl font-black uppercase leading-none tracking-tight md:text-5xl">
            {seasonName(latest)} honors are in
          </p>
          <p class="mt-3 max-w-[50ch] text-white/75">
            {honoreeCount(latest.awards)} Bulldogs earned NE8 All-Conference recognition. Browse
            every card, every season.
          </p>
          <span class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-bold text-primary-900 group-hover:bg-primary-50">
            View the awards
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="transition-[translate] duration-300 group-hover:translate-x-1"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </span>
        </a>
        <p class="mt-3 text-sm text-ink-500">
          Jump to the latest:{" "}
          <a href={seasonHref(latest)} class="font-semibold text-primary-600 hover:underline">
            {seasonName(latest)}
          </a>
        </p>
      </section>
    )
  }

  <section class="mx-auto max-w-content px-6 py-14">
    {
      articles.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <p class="text-ink-400">
          No NE8 news published yet — tag an article "NE8" in the CMS to have it show up here.
        </p>
      )
    }
  </section>
</BaseLayout>
