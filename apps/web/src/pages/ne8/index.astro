---
// polandathletics.com/ne8 — conference-specific news only. Pulls
// articles tagged "NE8" in the CMS via getArticlesForTag, same helper
// already used for other tag-scoped pages (e.g. Fans) — completely
// independent of the general News feed/excludeFromNewsFeed: an article
// can appear here, in the general feed, both, or (if flagged
// excludeFromNewsFeed) here only.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/articles/ArticleCard.astro";
import { getArticlesForTag } from "../../lib/payload";

const articles = await getArticlesForTag("ne8", 50);
---

<BaseLayout title="NE8 Conference" description="News and updates from the NE8 athletic conference.">
  <div class="border-b border-ink-100 py-12">
    <div class="mx-auto max-w-content px-6">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-primary-600">Conference</p>
      <h1 class="max-w-[20ch] text-h1 font-bold text-ink-900">NE8</h1>
      <p class="mt-3 max-w-[62ch] text-lg text-ink-600">
        News and updates from across the NE8 athletic conference.
      </p>
    </div>
  </div>

  <section class="mx-auto max-w-content px-6 py-14">
    {articles.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    ) : (
      <p class="text-ink-400">No NE8 news published yet — tag an article "NE8" in the CMS to have it show up here.</p>
    )}
  </section>
</BaseLayout>
