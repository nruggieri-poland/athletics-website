---
// polandathletics.com/ne8 — conference-specific news only. Pulls
// articles tagged "NE8" in the CMS via getArticlesForTag, same helper
// already used for other tag-scoped pages (e.g. Fans) — completely
// independent of the general News feed/excludeFromNewsFeed: an article
// can appear here, in the general feed, both, or (if flagged
// excludeFromNewsFeed) here only.
//
// Also the doorway to /ne8/awards — the All-Conference awards section
// hangs off this page in the URL and the breadcrumbs, so it leads here too.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/articles/ArticleCard.astro";
import { getArticlesForTag } from "../../lib/payload";
import type { AwardSeason } from "../../lib/awards";
import AwardCard from "../../components/awards/AwardCard.astro";
import { isPremium } from "@athletics/award-card";
import {
  SPOTLIGHT_ITEM,
  SPOTLIGHT_LIST,
  getAwardSeasons,
  honoreeCount,
  latestSeason,
  seasonHref,
  seasonName,
  sortAwards,
} from "../../lib/awards";

const articles = await getArticlesForTag("ne8", 50);

let seasons: AwardSeason[] = [];
try {
  seasons = await getAwardSeasons();
} catch {
  // CMS unreachable at build time — the awards section shows its empty state.
}
const latest = latestSeason(seasons);
// The most recent season's Player/Coach of the Year cards, shown here as a
// preview of /ne8/awards.
const spotlight = latest ? sortAwards(latest.awards).filter((award) => isPremium(award.honor)) : [];
---

<BaseLayout
  title="NE8 Conference"
  description="News, updates, and All-Conference awards from the NE8 athletic conference."
>
  <div class="border-b border-ink-100 py-12">
    <div class="mx-auto max-w-content px-6">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-primary-600">Conference</p>
      <h1 class="max-w-[20ch] text-h1 font-bold text-ink-900">NE8</h1>
      <p class="mt-3 max-w-[62ch] text-lg text-ink-600">
        News and updates from across the NE8 athletic conference.
      </p>
    </div>
  </div>

  <section class="border-b border-ink-100 bg-ink-50" aria-labelledby="ne8-awards-heading">
    <div class="mx-auto max-w-content px-6 py-12">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div>
          <h2 id="ne8-awards-heading" class="text-h3 font-bold text-ink-900">
            NE8 All-Conference Awards
          </h2>
          <p class="mt-2 text-ink-600">
            {
              latest
                ? `Most recent: ${seasonName(latest)}, ${latest.awards.length} awards to ${honoreeCount(latest.awards)} Poland Seminary athletes.`
                : "No awards have been posted yet."
            }
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          {
            latest && (
              <a
                href={seasonHref(latest)}
                class="rounded-full bg-primary-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-primary-700"
              >
                {seasonName(latest)} awards
              </a>
            )
          }
          <a
            href="/ne8/awards"
            class="rounded-full border border-ink-200 bg-surface px-5 py-2.5 text-sm font-bold text-ink-900 hover:border-primary-300"
          >
            All seasons
          </a>
        </div>
      </div>
      {
        spotlight.length > 0 && (
          <ul class={`mt-10 ${SPOTLIGHT_LIST}`}>
            {spotlight.map((award) => (
              <li class={SPOTLIGHT_ITEM}>
                <AwardCard award={award} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-content px-6 py-14" aria-labelledby="ne8-news-heading">
    <h2 id="ne8-news-heading" class="mb-6 text-h3 font-bold text-ink-900">NE8 News</h2>
    {
      articles.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <p class="text-ink-400">
          No NE8 news published yet — tag an article "NE8" in the CMS to have it show up here.
        </p>
      )
    }
  </section>
</BaseLayout>
