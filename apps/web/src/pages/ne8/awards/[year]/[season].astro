---
// polandathletics.com/ne8/awards/2025-2026/winter — one season's NE8
// All-Conference honors as a wall of award cards, grouped by honor
// (Players of the Year first) and filterable by award, sport, and grade.
// Filters live in the URL (?sport=boys-basketball&grade=Senior), so a
// filtered view can be shared or linked to directly from a sport's page.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import AwardsHero from "../../../../components/awards/AwardsHero.astro";
import AwardCard from "../../../../components/awards/AwardCard.astro";
import type { AwardSeason } from "../../../../lib/awards";
import {
  GRADES,
  HONORS,
  SEASON_ORDER,
  awardSportKey,
  awardSportLabel,
  getAwardSeasons,
  honorCounts,
  honoreeCount,
  photoUrl,
  schoolYearHref,
  seasonCover,
  seasonHref,
  seasonName,
  sortAwards,
} from "../../../../lib/awards";

export async function getStaticPaths() {
  let seasons: AwardSeason[] = [];
  try {
    seasons = await getAwardSeasons();
  } catch {
    // CMS unreachable at build time — skip these pages rather than fail.
  }
  return seasons.map((season) => ({
    params: { year: season.schoolYear, season: season.season.toLowerCase() },
    props: { season, all: seasons },
  }));
}

interface Props {
  season: AwardSeason;
  all: AwardSeason[];
}

const { season, all } = Astro.props;
const name = seasonName(season);
const awards = sortAwards(season.awards);
const counts = honorCounts(awards);
const people = honoreeCount(awards);

// Oldest → newest, so previous/next walk the seasons in the order they
// were announced, across school-year boundaries.
const chronological = [...all].sort(
  (a, b) =>
    a.schoolYear.localeCompare(b.schoolYear) ||
    SEASON_ORDER.indexOf(a.season) - SEASON_ORDER.indexOf(b.season),
);
const position = chronological.findIndex((entry) => entry.id === season.id);
const older = position > 0 ? chronological[position - 1] : undefined;
const newer = position >= 0 ? chronological[position + 1] : undefined;

const countPhrase = (count: number, singular: string, plural: string) =>
  `${count} ${count === 1 ? singular : plural}`;
const autoIntro = (() => {
  const poy = awards.filter((award) => award.honor === "player-of-the-year").length;
  const base = `In the ${name} season, ${countPhrase(people, "Bulldog was", "Bulldogs were")} recognized by the NE8's coaches and administrators with ${countPhrase(awards.length, "All-Conference honor", "All-Conference honors")}`;
  return poy > 0
    ? `${base}, including ${countPhrase(poy, "Player of the Year", "Players of the Year")}. Let's go, Dogs!`
    : `${base}. Let's go, Dogs!`;
})();
const intro = season.intro?.trim() || autoIntro;

const sections = HONORS.map((honor) => ({
  honor,
  awards: awards.filter((award) => award.honor === honor.value),
})).filter((section) => section.awards.length > 0);

const sportOptions = [
  ...new Map(awards.map((award) => [awardSportKey(award), awardSportLabel(award)])).entries(),
];
const gradeOptions = GRADES.filter((grade) => awards.some((award) => award.grade === grade));
const cover = seasonCover(season);
const featured = (value: string) => value === "player-of-the-year" || value === "coach-of-the-year";
---

<BaseLayout
  title={`${name} NE8 All-Conference`}
  description={intro}
  image={cover ? photoUrl(cover) : undefined}
  imageAlt={cover ? `${name} NE8 All-Conference honors` : undefined}
>
  <AwardsHero
    crumbs={[
      { label: "NE8", href: "/ne8" },
      { label: "Awards", href: "/ne8/awards" },
      { label: season.schoolYear, href: schoolYearHref(season.schoolYear) },
      { label: season.season, href: seasonHref(season) },
    ]}
    eyebrow="NE8 All-Conference"
    title={name}
    lede={intro}
    stats={[
      { value: people, label: people === 1 ? "Bulldog honored" : "Bulldogs honored" },
      ...counts.map(({ honor, count }) => ({
        value: count,
        label: count === 1 ? honor.label : honor.plural,
        color: honor.accent,
      })),
    ]}
    image={cover}
  >
    {
      season.galleryUrl && (
        <a
          href={season.galleryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-bold text-primary-900 hover:bg-primary-50"
        >
          View the full photo gallery
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>
      )
    }
  </AwardsHero>

  {
    awards.length > 0 ? (
      <>
        {/* Pinned under the site header (61px) on wide screens only — on a
          phone its rows would eat a third of the screen. */}
        <div
          class="z-30 border-b border-ink-100 bg-surface/90 backdrop-blur lg:sticky lg:top-[61px]"
          data-award-filters
        >
          <div class="mx-auto flex max-w-content flex-col gap-3 px-6 py-4 lg:flex-row lg:flex-wrap lg:items-center lg:gap-x-8">
            <fieldset class="flex min-w-0 items-center gap-2">
              <legend class="sr-only">Award</legend>
              <span
                class="w-14 shrink-0 text-xs font-semibold uppercase tracking-wide text-ink-400 lg:w-auto"
                aria-hidden="true"
              >
                Award
              </span>
              <div class="-my-1 flex gap-1.5 overflow-x-auto py-1">
                <button
                  type="button"
                  class="filter-chip"
                  data-filter="honor"
                  data-value=""
                  aria-pressed="true"
                >
                  All
                </button>
                {counts.map(({ honor }) => (
                  <button
                    type="button"
                    class="filter-chip"
                    data-filter="honor"
                    data-value={honor.value}
                    aria-pressed="false"
                  >
                    {honor.short}
                  </button>
                ))}
              </div>
            </fieldset>
            {sportOptions.length > 1 && (
              <fieldset class="flex min-w-0 items-center gap-2">
                <legend class="sr-only">Sport</legend>
                <span
                  class="w-14 shrink-0 text-xs font-semibold uppercase tracking-wide text-ink-400 lg:w-auto"
                  aria-hidden="true"
                >
                  Sport
                </span>
                <div class="-my-1 flex gap-1.5 overflow-x-auto py-1">
                  <button
                    type="button"
                    class="filter-chip"
                    data-filter="sport"
                    data-value=""
                    aria-pressed="true"
                  >
                    All
                  </button>
                  {sportOptions.map(([key, label]) => (
                    <button
                      type="button"
                      class="filter-chip"
                      data-filter="sport"
                      data-value={key}
                      aria-pressed="false"
                    >
                      {label}
                    </button>
                  ))}
                </div>
              </fieldset>
            )}
            {gradeOptions.length > 1 && (
              <fieldset class="flex min-w-0 items-center gap-2">
                <legend class="sr-only">Grade</legend>
                <span
                  class="w-14 shrink-0 text-xs font-semibold uppercase tracking-wide text-ink-400 lg:w-auto"
                  aria-hidden="true"
                >
                  Grade
                </span>
                <div class="-my-1 flex gap-1.5 overflow-x-auto py-1">
                  <button
                    type="button"
                    class="filter-chip"
                    data-filter="grade"
                    data-value=""
                    aria-pressed="true"
                  >
                    All
                  </button>
                  {gradeOptions.map((grade) => (
                    <button
                      type="button"
                      class="filter-chip"
                      data-filter="grade"
                      data-value={grade}
                      aria-pressed="false"
                    >
                      {grade}
                    </button>
                  ))}
                </div>
              </fieldset>
            )}
            <p class="text-sm text-ink-500 lg:ml-auto" aria-live="polite">
              <span data-result-count>{awards.length}</span> of {awards.length}
              <button
                type="button"
                class="ml-2 font-semibold text-primary-600 hover:underline"
                data-clear-filters
                hidden
              >
                Clear
              </button>
            </p>
          </div>
        </div>

        <div class="mx-auto max-w-content px-6 py-12 md:py-16">
          {sections.map(({ honor, awards: sectionAwards }) => (
            <section
              class="mb-16 last:mb-0"
              data-award-section
              aria-labelledby={`honor-${honor.value}`}
            >
              <div class="mb-6 flex items-baseline gap-3 border-b border-ink-100 pb-3">
                <span
                  class="h-3 w-3 shrink-0 rounded-full"
                  style={`background: ${honor.color}`}
                  aria-hidden="true"
                />
                <h2
                  id={`honor-${honor.value}`}
                  class="text-h3 font-black uppercase tracking-tight text-ink-900"
                >
                  {sectionAwards.length === 1 ? honor.label : honor.plural}
                </h2>
                <span class="text-sm font-semibold text-ink-400" data-section-count>
                  {sectionAwards.length}
                </span>
              </div>
              <ul
                class={
                  featured(honor.value)
                    ? "grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8"
                    : "grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
                }
              >
                {sectionAwards.map((award) => (
                  <li
                    data-award-item
                    data-honor={award.honor}
                    data-sport={awardSportKey(award)}
                    data-grade={award.grade ?? ""}
                  >
                    <AwardCard award={award} season={season} />
                  </li>
                ))}
              </ul>
            </section>
          ))}

          <div class="py-16 text-center" data-no-results hidden>
            <p class="text-lg font-semibold text-ink-900">No cards match those filters.</p>
            <button
              type="button"
              class="mt-3 font-semibold text-primary-600 hover:underline"
              data-clear-filters
            >
              Show all {awards.length}
            </button>
          </div>
        </div>
      </>
    ) : (
      <p class="mx-auto max-w-content px-6 py-16 text-ink-400">
        No award cards have been added to this season yet.
      </p>
    )
  }

  <nav aria-label="More seasons" class="border-t border-ink-100">
    <div class="mx-auto grid max-w-content gap-4 px-6 py-10 sm:grid-cols-3 sm:items-center">
      <div>
        {
          older && (
            <a href={seasonHref(older)} class="group inline-flex flex-col">
              <span class="text-xs font-semibold uppercase tracking-wide text-ink-400">
                &larr; Previous season
              </span>
              <span class="text-lg font-bold text-ink-900 group-hover:text-primary-600">
                {seasonName(older)}
              </span>
            </a>
          )
        }
      </div>
      <div class="sm:text-center">
        <a
          href={schoolYearHref(season.schoolYear)}
          class="text-sm font-semibold text-primary-600 hover:underline"
        >
          All {season.schoolYear} awards
        </a>
      </div>
      <div class="sm:text-right">
        {
          newer && (
            <a href={seasonHref(newer)} class="group inline-flex flex-col sm:items-end">
              <span class="text-xs font-semibold uppercase tracking-wide text-ink-400">
                Next season &rarr;
              </span>
              <span class="text-lg font-bold text-ink-900 group-hover:text-primary-600">
                {seasonName(newer)}
              </span>
            </a>
          )
        }
      </div>
    </div>
  </nav>
</BaseLayout>

<script>
  // Client-side filtering over the static card grid: one value per group
  // (honor/sport/grade, "" = all), mirrored into the query string so the
  // filtered view survives a reload and can be shared.
  const root = document.querySelector<HTMLElement>("[data-award-filters]");
  if (root) {
    const groups = ["honor", "sport", "grade"] as const;
    type Group = (typeof groups)[number];
    const state: Record<Group, string> = { honor: "", sport: "", grade: "" };
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const items = [...document.querySelectorAll<HTMLElement>("[data-award-item]")];
    const sections = [...document.querySelectorAll<HTMLElement>("[data-award-section]")];
    const countEl = root.querySelector("[data-result-count]");
    const noResults = document.querySelector<HTMLElement>("[data-no-results]");
    const clearButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-clear-filters]")];

    const params = new URLSearchParams(location.search);
    for (const group of groups) {
      const value = params.get(group) ?? "";
      if (chips.some((chip) => chip.dataset.filter === group && chip.dataset.value === value))
        state[group] = value;
    }

    const apply = () => {
      let visible = 0;
      for (const item of items) {
        const show = groups.every((group) => !state[group] || item.dataset[group] === state[group]);
        item.hidden = !show;
        if (show) visible++;
      }
      for (const section of sections) {
        const shown = section.querySelectorAll("[data-award-item]:not([hidden])").length;
        section.hidden = shown === 0;
        const count = section.querySelector("[data-section-count]");
        if (count) count.textContent = String(shown);
      }
      for (const chip of chips) {
        chip.setAttribute(
          "aria-pressed",
          String(state[chip.dataset.filter as Group] === chip.dataset.value),
        );
      }
      if (countEl) countEl.textContent = String(visible);
      if (noResults) noResults.hidden = visible > 0;
      const filtered = groups.some((group) => state[group]);
      clearButtons[0].hidden = !filtered;

      const next = new URLSearchParams(location.search);
      for (const group of groups) {
        if (state[group]) next.set(group, state[group]);
        else next.delete(group);
      }
      const query = next.toString();
      history.replaceState(
        null,
        "",
        `${location.pathname}${query ? `?${query}` : ""}${location.hash}`,
      );
    };

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        const group = chip.dataset.filter as Group;
        const value = chip.dataset.value ?? "";
        state[group] = state[group] === value ? "" : value;
        apply();
      });
    }
    for (const button of clearButtons) {
      button.addEventListener("click", () => {
        for (const group of groups) state[group] = "";
        apply();
      });
    }
    apply();
  }
</script>

<style>
  .filter-chip {
    flex: none;
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-ink-700);
    background: var(--color-ink-50);
    box-shadow: inset 0 0 0 1px var(--color-ink-200);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .filter-chip:hover {
    background: var(--color-ink-100);
  }
  .filter-chip[aria-pressed="true"] {
    color: #ffffff;
    background: var(--color-primary-600);
    box-shadow: none;
  }
</style>
