---
// One real HTML landing page per public document — the thing to actually
// share instead of a raw /api/media/file/* link, which can never carry a
// title/description/og:image since it isn't HTML at all. filename is the
// route param since Payload already enforces it unique; derived from the
// media doc's own url rather than a separate field.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PdfPreview from "../../components/shared/PdfPreview.astro";
import { getPublicMedia, getSiteSettings, mediaUrl } from "../../lib/payload";

export async function getStaticPaths() {
  const docs = await getPublicMedia();
  return docs.map((media) => ({
    params: { filename: media.url.split("/").pop() },
    props: { media },
  }));
}

const { media } = Astro.props;
const siteSettings = await getSiteSettings();
const siteName = siteSettings?.siteName || "Poland Seminary Bulldogs";

const isImage = media.mimeType?.startsWith("image/") ?? false;
const isPdf = media.mimeType === "application/pdf";
const title = media.title || media.alt;
---

<BaseLayout
  title={title}
  description={media.description}
  image={isImage ? mediaUrl(media, "card") : undefined}
  imageAlt={isImage ? media.alt : undefined}
>
  <div class="mx-auto max-w-content px-6 py-14">
    <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-primary-600">
      <a href="/" class="hover:text-primary-700">{siteName}</a> / Document
    </p>
    <h1 class="max-w-[30ch] text-h1 font-bold text-ink-900">{title}</h1>
    {media.description && <p class="mt-3 max-w-[62ch] text-lg text-ink-600">{media.description}</p>}

    {isPdf ? (
      <PdfPreview media={media} />
    ) : isImage ? (
      <div class="my-8">
        <img
          src={mediaUrl(media, "hero")}
          alt={media.alt}
          class="max-h-[80vh] w-full rounded-lg border border-ink-100 object-contain"
        />
        <a
          href={mediaUrl(media)}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-700"
        >
          View Full Size
        </a>
      </div>
    ) : (
      <a
        href={mediaUrl(media)}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-700"
      >
        Download
      </a>
    )}
  </div>
</BaseLayout>
