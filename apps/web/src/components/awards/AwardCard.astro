---
// One NE8 award as a holographic trading card — a port of React Bits'
// <ProfileCard /> (tilt, cursor glare, holo foil showing through a
// pattern) to a plain Astro component plus one shared script, so the
// otherwise fully static site doesn't take on React just for this. The
// script at the bottom is bundled once per page however many cards render.
//
// Mapping from ProfileCard: avatarUrl → the athlete's photo (framed by its
// CMS focal point), name/title → athlete and honor, handle/status → sport
// and grade, contact button → a link to the sport's page, backdropColor →
// the honor's color, holo → stronger for Players/Coaches of the Year, and
// iconUrl → the NE8 pattern below the foil shows through.
import type { Award, AwardSeason } from "../../lib/awards";
import {
  awardSportLabel,
  honorLabel,
  honorMeta,
  photoPosition,
  photoUrl,
  seasonName,
  seasonYear,
} from "../../lib/awards";

interface Props {
  award: Award;
  season: Pick<AwardSeason, "schoolYear" | "season">;
  // Skip the "catch the light" entrance — for cards inside a carousel or
  // anywhere a dozen of them would all flash at once.
  intro?: boolean;
  class?: string;
}

const { award, season, intro = true, class: className = "" } = Astro.props;

const honor = honorMeta(award.honor);
const photo = photoUrl(award.photo);
const sportLabel = awardSportLabel(award);
const year = seasonYear(season);
const initials = award.athleteName
  .split(/\s+/)
  .filter(Boolean)
  .map((part) => part[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();
const statusText = award.honor === "coach-of-the-year" ? "Head Coach" : award.grade;

// Tileable mask the foil shows through (ProfileCard's iconUrl). Inline SVG
// rather than an uploaded image: CSS masks fetch in CORS mode, and the
// CMS's uploads are served from another origin.
const pattern = `url("data:image/svg+xml,${encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120' viewBox='0 0 120 120'><g fill='#000'><text x='6' y='40' font-family='Arial Black,Arial,sans-serif' font-weight='900' font-size='28' letter-spacing='-1'>NE8</text><text x='66' y='100' font-family='Arial Black,Arial,sans-serif' font-weight='900' font-size='28' letter-spacing='-1'>NE8</text><path d='M92 14l3.5 7.2 7.9 1.1-5.7 5.6 1.3 7.9-7-3.7-7 3.7 1.3-7.9-5.7-5.6 7.9-1.1z'/><path d='M30 74l3.5 7.2 7.9 1.1-5.7 5.6 1.3 7.9-7-3.7-7 3.7 1.3-7.9-5.7-5.6 7.9-1.1z'/></g></svg>",
)}")`;

// ProfileCard's film grain for the foil's glow layer, verbatim.
const grain = `url("data:image/svg+xml,${encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' width='500' height='500'><filter id='g' x='0' y='0' width='100%' height='100%' color-interpolation-filters='sRGB'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0.55 0 0 0 -0.24 0.55 0 0 0 -0.24 0.55 0 0 0 -0.24 0 0 0 0 1'/></filter><rect width='100%' height='100%' filter='url(#g)'/></svg>",
)}")`;

const style = [
  `--pc-backdrop: linear-gradient(180deg, color-mix(in srgb, ${honor.color}, #ffffff 12%) 0%, color-mix(in srgb, ${honor.color}, #000000 30%) 100%)`,
  `--pc-holo: ${honor.holo}`,
  `--pc-glare: 0.5`,
  `--pc-accent: ${honor.accent}`,
  `--pc-pattern: ${pattern}`,
  `--pc-grain: ${grain}`,
  `--pc-photo-position: ${photoPosition(award.photo)}`,
].join("; ");
---

<article
  class={`profile-card ${photo ? "profile-card--photo" : ""} ${className}`
    .replace(/\s+/g, " ")
    .trim()}
  style={style}
  data-award-card
  data-intro={intro ? "true" : "false"}
  aria-label={`${award.athleteName}, ${honorLabel(award)}, ${sportLabel}`}
>
  <div class="profile-card__body">
    <div class="profile-card__tile">
      <span class="profile-card__sheen"></span>

      {
        photo ? (
          <img
            class="profile-card__photo"
            src={photo}
            alt=""
            loading="lazy"
            decoding="async"
            draggable="false"
          />
        ) : (
          <span class="profile-card__monogram" aria-hidden="true">
            {initials}
          </span>
        )
      }

      {
        /* Above the photo, unlike ProfileCard (which expects cut-out
          portraits and lets the foil show around them): full-bleed action
          shots would hide it entirely. See .profile-card--photo below. */
      }
      <span class="profile-card__holo">
        <span class="profile-card__holo-glow"></span>
        <span class="profile-card__holo-shift"></span>
      </span>

      <span class="profile-card__year" aria-hidden="true">
        <span>{year.slice(0, 2)}</span><span>{year.slice(2)}</span>
      </span>
      <span class="profile-card__badge" aria-hidden="true">NE8</span>

      <span class="profile-card__scrim"></span>
      <div class="profile-card__info">
        <p class="profile-card__honor">{honorLabel(award)}</p>
        <h3 class="profile-card__name">{award.athleteName}</h3>
        <p class="profile-card__title">NE8 All-Conference · {seasonName(season)}</p>
      </div>
      <span class="profile-card__tile-rim"></span>
    </div>

    <div class="profile-card__footer">
      <div class="profile-card__meta">
        <span class="profile-card__handle">{sportLabel}</span>
        {statusText && <span class="profile-card__status">{statusText}</span>}
      </div>
      {
        award.sport?.slug && (
          <a
            href={`/${award.sport.slug}`}
            class="profile-card__contact"
            aria-label={`${sportLabel} team page`}
          >
            Team
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        )
      }
    </div>

    <span class="profile-card__glare"></span>
    <span class="profile-card__shade"></span>
    <span class="profile-card__rim"></span>
  </div>
</article>

<script>
  // ProfileCard's spring engine, unchanged in behavior: the card's x/y
  // aim springs toward the pointer and a light value eases in/out, both
  // written out as CSS variables the stylesheet below reads. Each card's
  // loop only runs while something is moving, so a page of 40 idle cards
  // costs nothing.
  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const TILT = 12;
  const PARALLAX = 8;

  function initCard(root: HTMLElement) {
    const size = { width: root.offsetWidth, height: root.offsetHeight };
    const x = { p: 0, v: 0, target: 0 };
    const y = { p: 0, v: 0, target: 0 };
    const light = { p: 0, target: 0 };
    let raf = 0;
    let last = 0;
    let slowUntil = 0;
    let touchId: number | null = null;

    const write = () => {
      const angle = reduced ? 0 : TILT;
      const depth = reduced ? 0 : PARALLAX;
      const tilt = Math.min(1, Math.hypot(x.p, y.p));
      const style = root.style;
      style.setProperty("--pc-light-x", `${((x.p + 1) * 0.5 * size.width).toFixed(1)}px`);
      style.setProperty("--pc-light-y", `${((y.p + 1) * 0.5 * size.height).toFixed(1)}px`);
      style.setProperty("--pc-pointer-x", `${((x.p + 1) * 50).toFixed(2)}%`);
      style.setProperty("--pc-pointer-y", `${((y.p + 1) * 50).toFixed(2)}%`);
      style.setProperty("--pc-band-x", `${(50 + x.p * 15).toFixed(2)}%`);
      style.setProperty("--pc-band-y", `${(50 + y.p * 15).toFixed(2)}%`);
      style.setProperty("--pc-rotate-x", `${(y.p * angle).toFixed(3)}deg`);
      style.setProperty("--pc-rotate-y", `${(-x.p * angle).toFixed(3)}deg`);
      style.setProperty("--pc-shift-x", `${(x.p * depth).toFixed(2)}px`);
      style.setProperty("--pc-shift-y", `${(y.p * depth).toFixed(2)}px`);
      style.setProperty("--pc-reach", tilt.toFixed(4));
      style.setProperty("--pc-tilt", (tilt * light.p).toFixed(4));
      style.setProperty("--pc-active", light.p.toFixed(4));
    };

    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      const slow = now < slowUntil;
      const stiffness = slow ? 24 : 120;
      const damping = slow ? 9 : 16;
      const steps = Math.max(1, Math.ceil(dt / (1 / 120)));
      const h = dt / steps;
      for (let i = 0; i < steps; i++) {
        for (const axis of [x, y]) {
          axis.v += (stiffness * (axis.target - axis.p) - damping * axis.v) * h;
          axis.p += axis.v * h;
        }
      }
      const tau = light.target > light.p ? 0.18 : slow ? 0.9 : 0.45;
      light.p += (light.target - light.p) * (1 - Math.exp(-dt / tau));
      write();
      const moving =
        Math.abs(x.target - x.p) > 0.0005 ||
        Math.abs(y.target - y.p) > 0.0005 ||
        Math.abs(x.v) > 0.0005 ||
        Math.abs(y.v) > 0.0005 ||
        Math.abs(light.target - light.p) > 0.002;
      if (moving) {
        raf = requestAnimationFrame(frame);
      } else {
        x.p = x.target;
        y.p = y.target;
        light.p = light.target;
        write();
        raf = 0;
      }
    };

    const wake = () => {
      if (raf) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };

    const aim = (nx: number, ny: number, on = true) => {
      x.target = clamp(nx, -1, 1);
      y.target = clamp(ny, -1, 1);
      light.target = on ? 1 : 0;
      slowUntil = 0;
      wake();
    };

    const aimAt = (event: PointerEvent) => {
      const rect = root.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      aim(
        ((event.clientX - rect.left) / rect.width) * 2 - 1,
        ((event.clientY - rect.top) / rect.height) * 2 - 1,
      );
    };
    const release = () => aim(0, 0, false);

    root.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") aimAt(event);
    });
    root.addEventListener("pointermove", (event) => {
      if (event.pointerType === "mouse" || event.pointerId === touchId) aimAt(event);
    });
    root.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") release();
    });
    root.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse") return;
      touchId = event.pointerId;
      aimAt(event);
    });
    const onUp = (event: PointerEvent) => {
      if (event.pointerId !== touchId) return;
      touchId = null;
      release();
    };
    root.addEventListener("pointerup", onUp);
    root.addEventListener("pointercancel", onUp);
    // Keyboard users tabbing to the card's Team link still see it catch
    // the light, just without a cursor to aim it.
    root.addEventListener("focusin", () => aim(0.35, -0.3));
    root.addEventListener("focusout", release);

    new ResizeObserver(() => {
      size.width = root.offsetWidth;
      size.height = root.offsetHeight;
      write();
    }).observe(root);

    write();

    return {
      // ProfileCard plays this on mount; here it waits until the card is
      // actually scrolled into view, so cards further down the page still
      // get their moment.
      playIntro() {
        if (reduced) return;
        x.p = 0.62;
        y.p = -0.55;
        light.p = 1;
        slowUntil = performance.now() + 1400;
        write();
        wake();
      },
    };
  }

  const introObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        introObserver.unobserve(entry.target);
        cards.get(entry.target)?.playIntro();
      }
    },
    { threshold: 0.35 },
  );

  const cards = new Map<Element, ReturnType<typeof initCard>>();
  document.querySelectorAll<HTMLElement>("[data-award-card]").forEach((root) => {
    cards.set(root, initCard(root));
    if (root.dataset.intro === "true") introObserver.observe(root);
  });
</script>

<style>
  .profile-card {
    --pc-light-x: 50%;
    --pc-light-y: 50%;
    --pc-pointer-x: 50%;
    --pc-pointer-y: 50%;
    --pc-band-x: 50%;
    --pc-band-y: 50%;
    --pc-reach: 0;
    --pc-rotate-x: 0deg;
    --pc-rotate-y: 0deg;
    --pc-shift-x: 0px;
    --pc-shift-y: 0px;
    --pc-tilt: 0;
    --pc-active: 0;
    --pc-radius: 16px;
    --pc-parallax: 8px;
    --pc-pattern-size: 34% auto;

    /* ProfileCard's dark theme + dark foil — fixed regardless of the site
       theme, since these are trading cards, not page chrome. */
    --pc-frame: #1d1b24;
    --pc-frame-edge: rgba(255, 255, 255, 0.08);
    --pc-frame-highlight: rgba(255, 255, 255, 0.07);
    --pc-frame-shadow: 0 22px 44px -20px rgba(0, 0, 0, 0.8), 0 6px 16px -8px rgba(0, 0, 0, 0.5);
    --pc-tile: linear-gradient(180deg, #3a3644 0%, #27242f 100%);
    --pc-tile-edge: rgba(255, 255, 255, 0.07);
    --pc-tile-highlight: rgba(255, 255, 255, 0.12);
    --pc-tile-shadow: 0 4px 10px -4px rgba(0, 0, 0, 0.7);
    --pc-ink: #f4f4f5;
    --pc-muted: rgba(244, 244, 245, 0.6);
    --pc-hover: brightness(1.12);
    --pc-press: brightness(0.8);
    --pc-shade: rgba(0, 0, 0, 0.4);
    --pc-blend: color-dodge;
    --pc-holo-filter: hue-rotate(0deg);
    --pc-sheen: rgba(255, 255, 255, 0.16);
    --pc-holo-gain: 1.25;
    --pc-holo-detail: 1;

    position: relative;
    width: 100%;
    perspective: 1000px;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
  }

  .profile-card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px;
    border-radius: calc(var(--pc-radius) + 10px);
    background: var(--pc-frame);
    box-shadow: var(--pc-frame-shadow);
    transform: rotateX(var(--pc-rotate-x)) rotateY(var(--pc-rotate-y));
    will-change: transform;
  }

  .profile-card__tile {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--pc-radius);
    background: var(--pc-backdrop);
    box-shadow: var(--pc-tile-shadow);
    overflow: hidden;
    isolation: isolate;
    container-type: inline-size;
  }

  .profile-card__sheen,
  .profile-card__holo,
  .profile-card__scrim,
  .profile-card__tile-rim,
  .profile-card__glare,
  .profile-card__shade,
  .profile-card__rim {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .profile-card__sheen {
    background: radial-gradient(
      farthest-corner circle at calc(var(--pc-light-x) - 10px) calc(var(--pc-light-y) - 10px),
      var(--pc-sheen) 0%,
      transparent 55%
    );
    opacity: calc(var(--pc-holo) * var(--pc-active));
  }

  .profile-card__holo {
    --pc-spectrum: repeating-linear-gradient(
      0deg,
      hsl(2, 100%, 73%) 5%,
      hsl(53, 100%, 69%) 10%,
      hsl(93, 100%, 69%) 15%,
      hsl(176, 100%, 76%) 20%,
      hsl(228, 100%, 74%) 25%,
      hsl(260, 100%, 76%) 30%,
      hsl(2, 100%, 73%) 35%
    );
    --pc-bars: repeating-linear-gradient(
      -45deg,
      #0e152e 0%,
      hsl(180, 10%, 60%) 3.8%,
      hsl(180, 29%, 66%) 4.5%,
      hsl(180, 10%, 60%) 5.2%,
      #0e152e 10%,
      #0e152e 12%
    );
    --pc-falloff: radial-gradient(
      farthest-corner circle at var(--pc-pointer-x) var(--pc-pointer-y),
      hsla(0, 0%, 0%, 0.1) 12%,
      hsla(0, 0%, 0%, 0.15) 20%,
      hsla(0, 0%, 0%, 0.25) 120%
    );
    background-image: var(--pc-spectrum), var(--pc-bars), var(--pc-falloff);
    background-position:
      0 var(--pc-band-y),
      var(--pc-band-x) var(--pc-band-y),
      center;
    background-size:
      500% 500%,
      300% 300%,
      200% 200%;
    background-blend-mode: color, hard-light;
    mix-blend-mode: var(--pc-blend);
    filter: brightness(calc(0.66 + 0.19 * var(--pc-active)))
      contrast(calc(1.33 + 0.17 * var(--pc-active))) saturate(calc(0.33 + 0.17 * var(--pc-active)))
      var(--pc-holo-filter);
    opacity: calc(var(--pc-holo) * var(--pc-holo-gain) * (0.5 + 0.5 * var(--pc-active)));
    -webkit-mask-image: var(--pc-pattern);
    -webkit-mask-size: var(--pc-pattern-size);
    -webkit-mask-position: calc(50% - var(--pc-shift-x) * 1.5) calc(65% - var(--pc-shift-y) * 1.5);
    -webkit-mask-repeat: repeat;
    mask-image: var(--pc-pattern);
    mask-size: var(--pc-pattern-size);
    mask-position: calc(50% - var(--pc-shift-x) * 1.5) calc(65% - var(--pc-shift-y) * 1.5);
    mask-repeat: repeat;
  }

  /* Over a photo the foil is invisible at rest and only shimmers through
     the NE8 pattern where the light catches it, like a real holo card.
     Without one, it sits on the bare backdrop — kept, but toned down so
     the initials stay the focus. */
  .profile-card--photo .profile-card__holo {
    opacity: calc(var(--pc-holo) * 0.75 * var(--pc-active));
  }
  .profile-card:not(.profile-card--photo) .profile-card__holo {
    opacity: calc(var(--pc-holo) * (0.18 + 0.4 * var(--pc-active)));
  }

  .profile-card__holo-glow,
  .profile-card__holo-shift {
    position: absolute;
    inset: 0;
    opacity: calc(var(--pc-active) * var(--pc-holo-detail));
  }

  .profile-card__holo-glow {
    background-image:
      linear-gradient(
        45deg,
        hsl(176, 100%, 76%),
        hsl(228, 100%, 74%),
        hsl(260, 100%, 76%),
        hsl(2, 100%, 73%),
        hsl(53, 100%, 69%),
        hsl(93, 100%, 69%)
      ),
      radial-gradient(
        circle at var(--pc-pointer-x) var(--pc-pointer-y),
        hsl(0, 0%, 70%) 0%,
        hsla(0, 0%, 30%, 0.2) 90%
      ),
      var(--pc-grain);
    background-size:
      250% 250%,
      100% 100%,
      220px 220px;
    background-position:
      var(--pc-pointer-x) var(--pc-pointer-y),
      center,
      0 0;
    background-blend-mode: color-dodge;
    filter: brightness(calc(2 - var(--pc-reach))) contrast(calc(var(--pc-reach) + 2))
      saturate(calc(0.5 + var(--pc-reach)));
    mix-blend-mode: luminosity;
  }

  .profile-card__holo-shift {
    background-image: var(--pc-spectrum), var(--pc-bars), var(--pc-falloff);
    background-position:
      0 var(--pc-band-y),
      calc(var(--pc-band-x) * 0.4) calc(var(--pc-band-y) * 0.5),
      center;
    background-size:
      200% 300%,
      700% 700%,
      100% 100%;
    background-blend-mode: color, hard-light;
    mix-blend-mode: difference;
    filter: brightness(0.8) contrast(1.5);
  }

  .profile-card__photo {
    position: absolute;
    inset: calc(var(--pc-parallax) * -1);
    width: calc(100% + var(--pc-parallax) * 2);
    height: calc(100% + var(--pc-parallax) * 2);
    object-fit: cover;
    object-position: var(--pc-photo-position);
    transform: translate3d(var(--pc-shift-x), var(--pc-shift-y), 0);
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }

  /* No photo yet — the athlete's initials, big and quiet, so a season can
     go live before every headshot is in without leaving holes in the grid. */
  .profile-card__monogram {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-bottom: 22%;
    font-size: clamp(3.5rem, 30cqi, 6rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.16);
    transform: translate3d(var(--pc-shift-x), var(--pc-shift-y), 0);
  }

  .profile-card__year {
    position: absolute;
    top: 14px;
    left: 16px;
    display: flex;
    flex-direction: column;
    font-size: 26px;
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.03em;
    color: #ffffff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
  }

  .profile-card__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.35);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ffffff;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .profile-card__scrim {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.7) 8%,
      rgba(0, 0, 0, 0.56) 16%,
      rgba(0, 0, 0, 0.4) 24%,
      rgba(0, 0, 0, 0.24) 32%,
      rgba(0, 0, 0, 0.1) 40%,
      rgba(0, 0, 0, 0.02) 48%,
      rgba(0, 0, 0, 0) 54%
    );
  }

  .profile-card__info {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 16px;
    color: #ffffff;
  }

  .profile-card__honor {
    display: inline-block;
    margin: 0 0 8px;
    padding: 3px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--pc-accent), transparent 78%);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pc-accent), transparent 45%);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pc-accent);
  }

  .profile-card__name {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    line-height: 1.1;
