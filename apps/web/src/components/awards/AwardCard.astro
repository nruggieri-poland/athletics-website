---
// One NE8 award as a holographic trading card — a port of React Bits'
// <ProfileCard /> (tilt, cursor glare, holo foil showing through a
// pattern), without React. The design itself (markup, card.css, and the
// tilt engine) lives in packages/award-card so the CMS's Instagram export
// draws exactly the same card; this component maps an Award onto it.
//
// Mapping from ProfileCard: avatarUrl → the athlete's photo (framed by its
// CMS focal point), name/title → athlete and honor, handle/status → sport
// and grade, contact button → a link to the sport's page, backdropColor →
// the honor's color, holo → stronger for Players/Coaches of the Year, and
// iconUrl → the NE8 pattern the foil shows through.
import "@athletics/award-card/card.css";
import { cardHtml } from "@athletics/award-card";
import type { Award, AwardSeason } from "../../lib/awards";
import {
  awardSportLabel,
  honorLabel,
  photoPosition,
  photoUrl,
  seasonName,
  seasonYear,
} from "../../lib/awards";

interface Props {
  award: Award;
  season: Pick<AwardSeason, "schoolYear" | "season">;
  // Skip the "catch the light" entrance — for cards inside a carousel or
  // anywhere a dozen of them would all flash at once.
  intro?: boolean;
  class?: string;
}

const { award, season, intro = true, class: className = "" } = Astro.props;

const html = cardHtml({
  name: award.athleteName,
  honor: award.honor,
  honorText: honorLabel(award),
  sportLabel: awardSportLabel(award),
  statusText: award.honor === "coach-of-the-year" ? "Head Coach" : award.grade,
  year: seasonYear(season),
  seasonLabel: seasonName(season),
  photoSrc: photoUrl(award.photo) || undefined,
  photoPosition: photoPosition(award.photo),
  teamHref: award.sport?.slug ? `/${award.sport.slug}` : undefined,
  intro,
  className,
});
---

<Fragment set:html={html} />

<script>
  import { initAwardCards } from "@athletics/award-card/engine";

  initAwardCards();
</script>
