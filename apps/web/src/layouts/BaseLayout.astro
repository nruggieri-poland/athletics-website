---
import "../styles/global.css";
import TopBanner from "../components/nav/TopBanner.astro";
import Header from "../components/nav/Header.astro";
import Footer from "../components/nav/Footer.astro";
import { getSports, getTeams, getSiteSettings, getNavigation, mediaUrl } from "../lib/payload";

// ---------------------------------------------------------------------
// How to change what a page looks like when it's shared (Facebook,
// iMessage, Slack, etc.) — no Payload needed for any of this:
//
// Every page passes these straight to <BaseLayout ...> in its own .astro
// file's frontmatter (e.g. apps/web/src/pages/boosters/index.astro). Open
// that file, find the <BaseLayout> tag, and edit the props directly:
//
//   title        — the page's title (also the browser tab title)
//   description  — the preview card's body text
//   image        — an absolute image URL for this specific page. Omit it
//                  and the page falls back to SiteSettings' Social Share
//                  Image, then the site logo — see the ogImage fallback
//                  chain below. Only set this per-page when you want a
//                  DIFFERENT image than that sitewide default (e.g. an
//                  article already does this with its own heroImage).
//   imageAlt     — alt text describing the image, for screen readers
//                  reading the shared link's preview card. Only matters
//                  when `image` is also set.
//
// Articles and document pages (news/[slug].astro, documents/[filename].astro)
// already wire these up from their own CMS-editable fields (title, excerpt,
// heroImage/alt) — change those in Payload as usual, not here.
// ---------------------------------------------------------------------
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description = "Poland Seminary Bulldogs Athletics",
  image,
  imageAlt,
  type = "website",
  noindex = false,
} = Astro.props;

let sports: Awaited<ReturnType<typeof getSports>> = [];
let teams: Awaited<ReturnType<typeof getTeams>> = [];
let siteSettings: Awaited<ReturnType<typeof getSiteSettings>> | null = null;
let navigation: Awaited<ReturnType<typeof getNavigation>> | null = null;

try {
  [sports, teams, siteSettings, navigation] = await Promise.all([
    getSports(),
    getTeams(),
    getSiteSettings(),
    getNavigation(),
  ]);
} catch {
  // CMS unreachable at build time — render the shell with empty nav data
  // rather than failing the whole build.
}

const siteName = siteSettings?.siteName || "Poland Seminary Bulldogs";
const logo = siteSettings?.logo;
const faviconHref = logo?.url ? mediaUrl(logo) : "/favicon.svg";
const faviconType = logo?.mimeType || "image/svg+xml";

// A per-page `image` prop (an article's heroImage, a document's own file)
// wins; otherwise every page falls back to SiteSettings' dedicated
// socialImage (a wide landscape photo meant for this), and only as a last
// resort to the logo — the logo is square-ish, made for the header/
// favicon, and looks cropped/awkward stretched into a big preview card.
const socialImage = siteSettings?.socialImage;
const ogImage =
  image ||
  (socialImage?.url ? mediaUrl(socialImage, "card") : undefined) ||
  (logo?.url ? mediaUrl(logo, "card") : undefined);
// Only meaningful alongside a per-page `image` — the sitewide fallbacks
// above (socialImage/logo) don't carry their own alt text to reuse here.
const ogImageAlt = image ? imageAlt : undefined;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type={faviconType} href={faviconHref} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <script is:inline>
      // Runs before first paint so a returning visitor's saved theme choice
      // applies immediately — no flash of the wrong theme. A fresh visitor
      // with no saved choice gets nothing set here and falls through to the
      // `prefers-color-scheme` CSS fallback in global.css instead.
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch {
          // Private browsing / storage disabled — fall through to the
          // prefers-color-scheme CSS fallback, same as a fresh visitor.
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>
    <TopBanner address={siteSettings?.address} socialLinks={siteSettings?.socialLinks} />
    <Header siteName={siteName} logo={logo} sports={sports} teams={teams} navigation={navigation} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer siteName={siteName} logo={logo} navigation={navigation} />
  </body>
</html>
