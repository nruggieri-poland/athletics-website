DATABASE_URI=postgresql://localhost:5432/athletics
PAYLOAD_SECRET=changeme-generate-a-random-32-char-secret
PAYLOAD_SYNC_API_KEY=changeme-generate-a-random-key-shared-with-eventlink-sync
# Shared secret the apps/web build uses to read the Redirects collection,
# which is otherwise admin-only (not public like every other collection).
PAYLOAD_BUILD_API_KEY=changeme-generate-a-random-key-shared-with-the-web-build
# The CMS admin's real public origin(s), comma-separated if more than one.
# Without this, Payload accepts its auth cookie regardless of the request's
# Origin header — set this in production or a malicious site could make
# authenticated requests using an admin's active session.
CSRF_ORIGINS=https://cms.polandathletics.com
CF_ZONE_ID=
CF_API_TOKEN=
